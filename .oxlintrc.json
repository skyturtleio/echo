{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "vitest"],
  "categories": { "correctness": "error", "suspicious": "warn" },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/consistent-type-imports": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-expect-error": true,
        "ts-check": false
      }
    ],
    "no-underscore-dangle": ["warn", { "allow": ["_tag"] }],
    "import/no-cycle": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "effect/schema",
            "message": "Use the stable `effect/Schema` module; `effect/schema` is a different, unstable barrel."
          }
        ],
        "patterns": [
          {
            "group": ["foldkit", "foldkit/**"],
            "message": "Only examples may import FoldKit; the engine and its adapter never do (design §1)."
          }
        ]
      }
    ],
    "vitest/no-standalone-expect": [
      "error",
      { "additionalTestBlockFunctions": ["it.effect", "it.live", "it.scoped", "it.scopedLive", "it.layer"] }
    ]
  },
  "overrides": [
    {
      "files": ["src/domain/**", "src/client/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "effect/schema",
                "message": "Use the stable `effect/Schema` module; `effect/schema` is a different, unstable barrel."
              }
            ],
            "patterns": [
              {
                "group": ["**/server", "**/server/**", "echo-sync/server"],
                "message": "Domain and browser code never import src/server."
              },
              {
                "group": ["node:*", "bun", "bun:*", "@effect/platform-*", "@effect/sql-*"],
                "message": "Domain and browser code must not depend on server platform packages."
              },
              { "group": ["foldkit", "foldkit/**"], "message": "Only examples may import FoldKit (design §1)." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [{ "name": "effect/schema", "message": "Use the stable effect/Schema module." }],
            "patterns": [
              {
                "group": [
                  "**/server",
                  "**/server/**",
                  "echo-sync/server",
                  "**/client",
                  "**/client/**",
                  "echo-sync/client",
                  "**/protocol",
                  "**/protocol.ts",
                  "echo-sync/protocol"
                ],
                "message": "The pure domain layer must not depend on client, server, or wire protocol."
              },
              {
                "group": [
                  "node:*",
                  "bun",
                  "bun:*",
                  "@effect/platform-*",
                  "@effect/sql-*",
                  "effect/http",
                  "effect/rpc",
                  "effect/sql",
                  "effect/workers",
                  "foldkit",
                  "foldkit/**"
                ],
                "message": "The domain layer must not depend on transport, storage, or UI frameworks."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["examples/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "paths": [{ "name": "effect/schema", "message": "Use the stable effect/Schema module." }] }
        ]
      }
    },
    {
      "files": ["**/*.story.test.ts"],
      "rules": { "unicorn/no-thenable": "off" }
    }
  ],
  "ignorePatterns": ["node_modules"]
}
