{
  "name": "echo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./domain": "./src/domain/index.ts",
    "./domain/testing": "./src/domain/testing/index.ts",
    "./protocol": "./src/protocol.ts",
    "./server": "./src/server/index.ts",
    "./client": "./src/client/index.ts",
    "./foldkit": "./src/foldkit/index.ts"
  },
  "scripts": {
    "check": "bun run typecheck && bun run lint && oxfmt --check && vitest run",
    "typecheck": "effect-tsgo tsc@7.1.0-beta --noEmit",
    "lint": "oxlint --deny-warnings && effect-tsgo oxlint --config .oxlintrc.type-aware.json --type-aware --deny-warnings",
    "test": "vitest run",
    "test:pg": "ECHO_PG_URL=${ECHO_PG_URL:-postgres://postgres@127.0.0.1:5432/postgres} vitest run src/server test/",
    "fmt": "oxfmt",
    "lsp": "effect-tsgo tsc@7.1.0-beta --lsp --stdio"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.5"
  },
  "devDependencies": {
    "@effect/tsgo": "0.59.0",
    "@effect/vitest": "4.0.5",
    "@types/bun": "1.4.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.1.0-beta",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "effect": "4.0.5",
    "vitest": ">=5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
